# ============================================================
# Fitnit Challenge — Production secrets (template)
# Copy thành .env.prod rồi điền giá trị thật. KHÔNG commit .env.prod.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ============================================================

# ── Database ──
POSTGRES_DB=fit_challenge
POSTGRES_USER=postgres
# Bắt buộc — đặt mật khẩu mạnh:
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT (tối thiểu 32 ký tự) ──
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRATION=86400000

# ── Bí mật ký kết quả thi (backend + fitness-ai dùng chung) ──
# Chống gian lận điểm: pose service ký HMAC, backend xác minh. Đặt chuỗi ngẫu nhiên mạnh.
POSE_SIGNING_SECRET=change-me-to-a-long-random-pose-signing-secret

# ── Domain public (dùng cho CORS + sinh URL file) ──
# Ví dụ: https://fitnit.com  (không có dấu / ở cuối)
PUBLIC_ORIGIN=https://your-domain.com

# ── File storage ──
# local: lưu trong volume/container; s3: upload ảnh/video mới lên Amazon S3.
STORAGE_PROVIDER=local
AWS_REGION=ap-southeast-1
S3_UPLOAD_BUCKET=

# ── Database backup → S3 (service db-backup, BẮT BUỘC trước khi nhận tiền) ──
# Bucket lưu backup — NÊN tách khỏi S3_UPLOAD_BUCKET (backup là dữ liệu nhạy cảm,
# không public). Tạo bucket riêng + chặn public access.
BACKUP_S3_BUCKET=fitnit-db-backups
BACKUP_KEEP_DAYS=14          # giữ 14 bản gần nhất, tự xoá cũ hơn
BACKUP_HOUR_UTC=19          # 19h UTC = 2h sáng giờ VN
# AWS credentials cho cả upload ảnh lẫn backup.
# Trên EC2 có IAM role: để TRỐNG (SDK tự dùng role).
# Trên VPS thường (DigitalOcean/Vultr/...): điền access key có quyền S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email / SMTP (forgot password) ──
# Để trống MAIL_USERNAME nếu chưa setup — token sẽ log ra console thay vì gửi mail.
# Gmail: bật 2FA rồi tạo App Password (Google Account → Security → App Passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fitnit.vn
MAIL_FROM_NAME=Fitnit Challenge

# ── VNPay (thanh toán) ──
# Sandbox mặc định. Khi có merchant production: điền TMN_CODE/HASH_SECRET thật
# và đổi VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ── Sentry (giám sát lỗi) — tùy chọn, để TRỐNG = tắt ──
# Tạo project miễn phí ở sentry.io → lấy DSN. BE và FE dùng 2 DSN khác nhau
# (2 project, hoặc 2 platform trong 1 project). VITE_SENTRY_DSN bake lúc build
# frontend nên đổi nó phải rebuild frontend.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Plausible analytics (FE) — để TRỐNG = tắt ──
# Đăng ký domain ở plausible.io rồi điền vào đây (vd fitnit.vn). Bake lúc build.
VITE_PLAUSIBLE_DOMAIN=

# ── Frontend build-time API URL ──
# Để TRỐNG để frontend gọi /api tương đối qua nginx (same-origin, khuyến nghị).
# Chỉ điền nếu tách subdomain API riêng.
VITE_API_URL=

# Lưu ý: GROQ_API_KEY của AI service đọc từ ai-service/.env (không đặt ở đây).
