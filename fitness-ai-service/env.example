# Server Configuration
HOST=0.0.0.0
PORT=5001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# MediaPipe Configuration
MEDIAPIPE_MODEL_COMPLEXITY=1
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5

# Anti-cheat: HMAC key chia sẻ với backend (SPRING_POSE_SIGNING_SECRET phải khớp).
# Để trống = tắt ký (chỉ dùng khi dev local, KHÔNG để trống trên production).
# Sinh key: python3 -c "import secrets; print(secrets.token_hex(32))"
POSE_SIGNING_SECRET=

