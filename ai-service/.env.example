# AI Service Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# REQUIRED: Groq API Key
# Get your API key from: https://console.groq.com/keys
# ==========================================
# Lấy key tại https://console.groq.com/keys — KHÔNG điền key thật vào file này
GROQ_API_KEY=your_groq_api_key_here
# Lấy key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# OPTIONAL: Server Configuration
# ==========================================
BE_API_URL="http://localhost:8080" # Example URL for local Java backend
# PORT=8001
# HOST=0.0.0.0

# ==========================================
# OPTIONAL: Groq Model Configuration
# ==========================================
# GROQ_SMART_MEAL_MODEL=llama-3.1-8b-instant
# GROQ_TEMPERATURE=0.7

# ==========================================
# OPTIONAL: LLM Provider (chống lock-in + fail-over)
# ==========================================
# Mặc định dùng Groq qua GROQ_API_KEY ở trên. Để đổi nhà cung cấp mà KHÔNG sửa code,
# đặt base_url + key tương thích OpenAI (Together.ai, DeepInfra, OpenRouter, vLLM self-host...):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=                       # nếu trống, tự fallback sang GROQ_API_KEY
# LLM_MODEL=                         # ép 1 model cho MỌI call (để trống = giữ model riêng mỗi tác vụ)
#
# Provider DỰ PHÒNG — khi primary lỗi/sập, tự chuyển sang (cần cả 2 dòng):
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=                # id model trên provider dự phòng (id khác nhau giữa các hãng)

# ==========================================
# OPTIONAL: Debug Mode
# ==========================================
# DEBUG=true
# LOG_LEVEL=info
