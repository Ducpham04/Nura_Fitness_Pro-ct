# ============================================================
# Fitnit Challenge — Production Environment (build-time)
# ============================================================
# Dùng cho `vite build` (mode=production).
#
# Kiến trúc prod: nginx phục vụ SPA và proxy /api -> backend trên CÙNG origin.
# => Để VITE_API_URL TRỐNG để frontend gọi '/api' tương đối (same-origin),
#    nginx sẽ chuyển tiếp tới backend. Không CORS, chỉ cần 1 domain + 1 cert TLS.
#
# Nếu muốn tách subdomain API (vd https://api.fitnit.com), điền giá trị đầy đủ
# vào đây — khi đó phải cấu hình CORS_ALLOWED_ORIGINS ở backend cho khớp.
VITE_API_URL=

# App metadata
VITE_APP_NAME=Fitnit Challenge
VITE_APP_ENV=production

# Sentry (giám sát lỗi FE) — để TRỐNG = tắt. Dán DSN từ project Sentry để bật.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Plausible analytics — để TRỐNG = tắt. Điền domain đã đăng ký ở Plausible để bật.
# (vd fitnit.vn). Nếu self-host Plausible, đặt thêm VITE_PLAUSIBLE_SRC.
VITE_PLAUSIBLE_DOMAIN=
