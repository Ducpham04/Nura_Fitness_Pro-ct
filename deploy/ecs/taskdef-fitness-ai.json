{
  "family": "nura-fitness-ai",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::952669801986:role/nura-prod-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "fitness-ai",
      "image": "952669801986.dkr.ecr.ap-southeast-1.amazonaws.com/nura-prod/nura-fitness-ai:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 5001, "protocol": "tcp" }],
      "environment": [
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "5001" },
        { "name": "MEDIAPIPE_MODEL_COMPLEXITY", "value": "1" }
      ],
      "secrets": [
        { "name": "POSE_SIGNING_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:952669801986:secret:nura/prod/pose-UU9FQX" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/nura/prod/fitness-ai",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
