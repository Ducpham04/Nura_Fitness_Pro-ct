# ============================================
# Fit Challenge - Environment Template (EC2 compose)
# ============================================
# Copy to .env and fill values.
#
# Used by: docker-compose.ec2.yml (and deploy.sh)
#

# ============================================
# AWS RDS MySQL
# ============================================
RDS_HOST=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=fit_challenge
RDS_USERNAME=admin
RDS_PASSWORD=change_me

# ============================================
# Spring Boot / JDBC (optional: you can supply SPRING_DATASOURCE_* instead)
# ============================================
#SPRING_DATASOURCE_URL=jdbc:mysql://<host>:3306/fit_challenge?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
#SPRING_DATASOURCE_USERNAME=admin
#SPRING_DATASOURCE_PASSWORD=change_me

# ============================================
# JWT
# ============================================
JWT_SECRET=change_me_min_32_chars
JWT_EXPIRATION=86400000

# ============================================
# CORS (CloudFront domain or your FE domain)
# ============================================
CORS_ALLOWED_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# ============================================
# Storage (S3 recommended in prod)
# ============================================
STORAGE_TYPE=s3
AWS_S3_BUCKET_NAME=fitaichallengeprop
AWS_S3_REGION=ap-southeast-2
# Prefer IAM role on EC2; only set keys if necessary
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_USE_PRESIGNED_URL=true

# ============================================
# AI Service (same server, docker compose service name)
# ============================================
AI_SERVICE_URL=http://python-ai:5001

