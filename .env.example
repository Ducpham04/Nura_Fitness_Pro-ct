# ============================================================
# Viway — biến môi trường cho stack LOCAL (docker-compose.local.yml / ./dev.sh)
# ------------------------------------------------------------
#   cp .env.example .env          # docker compose tự đọc file .env ở thư mục gốc
#   cp ai-service/.env.example ai-service/.env   # điền GROQ_API_KEY
#
# Mọi biến đều có giá trị mặc định AN TOÀN CHO DEV trong compose — file này chỉ để
# bạn ghi đè. Production dùng .env.prod.example (mọi secret là bắt buộc).
# KHÔNG commit file .env thật.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=fit_challenge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password

# ── Backend (Spring Boot) ───────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# Phải khớp POSTGRES_PASSWORD ở trên
SPRING_DATASOURCE_PASSWORD=change-me-local-db-password
# Flyway tạo schema + seed (roles, admin, dữ liệu gốc). Giữ true.
SPRING_FLYWAY_ENABLED=true

# JWT HS256 — tối thiểu 32 ký tự. Tạo nhanh: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
# Thời hạn access token (ms) — mặc định 24h; refresh token 7 ngày
JWT_EXPIRATION=86400000

# Bí mật HMAC dùng chung giữa backend và fitness-ai-service (chống gian lận điểm thi)
POSE_SIGNING_SECRET=change-me-pose-signing-secret

# Origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_PATH=/app/uploads/

# ── Tuỳ chọn (để trống = tắt tính năng tương ứng) ───────────
# Lưu ý: compose local không chuyển các biến dưới đây vào container; chúng có hiệu
# lực khi chạy backend trực tiếp (cd backend && ./mvnw spring-boot:run).
# Đăng nhập Google — OAuth Client ID (định danh công khai)
GOOGLE_CLIENT_ID=
# Gửi email quên mật khẩu (không cấu hình → token in ra log backend)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Thanh toán VNPay / SePay (sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
# Giám sát lỗi backend
SENTRY_DSN=

# ── Script tiện ích (scripts/*.py) ──────────────────────────
YOUTUBE_API_KEY=
RAPIDAPI_KEY=
DB_URL=postgresql://postgres:change-me-local-db-password@localhost:5432/fit_challenge
