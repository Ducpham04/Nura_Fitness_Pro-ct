# ============================================================
# Viway Frontend — biến môi trường (Vite, build-time)
# ------------------------------------------------------------
#   cp .env.example .env      # local dev (git-ignored)
#
# .env.production được commit và chỉ chứa giá trị CÔNG KHAI (client ID,
# measurement ID…). Mọi biến VITE_* đều lộ ra trình duyệt — tuyệt đối
# không đặt secret ở đây.
# ============================================================

# URL backend, không có "/" cuối. Để trống = gọi /api tương đối (same-origin qua nginx).
# Dev: Vite proxy /api → giá trị này.
VITE_API_URL=http://localhost:8080
# WebSocket pose service (MediaPipe) cho thử thách camera.
# Để trống: dev → ws://localhost:5001, prod https → wss://<host>/pose
VITE_POSE_WS_URL=

VITE_APP_NAME=Viway
VITE_APP_ENV=development
# Origin public dùng cho canonical/og:url (mặc định https://app.viway.id.vn)
VITE_SITE_URL=http://localhost:5173

# ── Tuỳ chọn — để TRỐNG = tắt ───────────────────────────────
# Đăng nhập Google (OAuth Client ID)
VITE_GOOGLE_CLIENT_ID=
# Google Analytics 4 measurement ID (vd G-XXXXXXX)
VITE_GA_ID=
# Microsoft Clarity project ID
VITE_CLARITY_ID=
# Plausible analytics domain
VITE_PLAUSIBLE_DOMAIN=
# Sentry DSN (SDK chỉ được tải khi có giá trị)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
