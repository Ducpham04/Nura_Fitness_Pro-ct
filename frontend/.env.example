# ============================================================
# Fitnit Challenge — Environment Variables Template
# ============================================================
# Copy this file to .env (for local dev) or .env.production.local
# (for local production testing) and fill in real values.
#
# .env                  — local development (git-ignored)
# .env.production       — production defaults (committed, no secrets)
# .env.production.local — production overrides on this machine (git-ignored)
# ============================================================

# ---- Backend API ----
# URL of the Spring Boot backend, no trailing slash
# Local:      http://localhost:8080
# Production: https://api.fitnit.example.com
VITE_API_URL=http://localhost:8080

# ---- App metadata ----
VITE_APP_NAME=Fitnit Challenge
VITE_APP_ENV=development

# Microsoft Clarity — để TRỐNG ở local (chỉ bật trên prod)
VITE_CLARITY_ID=
